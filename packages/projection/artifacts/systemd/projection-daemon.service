# Projection+ settings daemon (WIP, not car-validated). Installed by
# packages/projection/scripts/run_stuff.sh; removed by run_stuff_restore.sh.
# No SmackProcessLabel: the binary carries SMACK64EXEC "_" (same as Tweaks).
[Unit]
Description=Projection+ settings daemon (Ioniq 5 Gen5W)
ConditionPathExists=/rw_data/projection/projection_daemon

[Service]
Type=simple
Environment=PATH=/bin:/sbin:/usr/bin:/usr/sbin
ExecStart=/bin/sh -c 'exec /rw_data/projection/projection_daemon --port 8092 >> /rw_data/projection/daemon.log 2>&1'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
