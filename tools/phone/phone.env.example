# Copy to phone.env (ignored by tools/phone/.gitignore) and fill in with values
# for your own hardware. Never commit the filled-in copy.
#
# Split of responsibilities:
#   phone.env   - host-side ADB deployment and on-device provisioning inputs
#   config.json - on-device dm/loop devices, geometry and detector thresholds

# --- host deploy -------------------------------------------------------------
PHONE_SERIAL=CHANGEME
RIG_DIR=/data/local/tmp/scourge

# --- on-device provisioning --------------------------------------------------
GEN_IMAGE=$RIG_DIR/usb.img        # genuine full image
EVIL_IMAGE=$RIG_DIR/evil.img      # region-sized padded modified file
GADGET_DIR=/config/usb_gadget/g1
UDC=CHANGEME                    # the phone's USB peripheral controller
MASS_STORAGE_FN=mass_storage.0  # configfs mass-storage function name
CONFIG_NAME=c.1                 # configfs configuration name
LUN_NAME=lun.0                  # LUN inside the mass-storage function
