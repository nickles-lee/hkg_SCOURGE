[Unit]
Description=SCOURGE Rust daemon (my-daemon)
After=network.target
ConditionPathExists=/rw_data/apps/my-daemon/bin/my-daemon

[Service]
Type=simple
ExecStart=/rw_data/apps/my-daemon/bin/my-daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
