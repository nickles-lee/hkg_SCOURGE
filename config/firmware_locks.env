# firmware_locks.env — the single source of truth for firmware compatibility.
#
# TARGET: Hyundai Ioniq 5 Gen5W_L (Linux), EU region,
#         firmware NE_E.EUR.S5W_L.001.001.260128 (build 2026-01-28).
#
# Every patcher and verifier in this repo sources these values and ABORTS on
# any mismatch. Never carry a patch table to another firmware package unless
# the stock ELF hash matches the value pinned here — see docs/09-porting.md.
# Adding a new firmware/region/car means adding a NEW section with NEW values,
# re-derived per docs/10-ghidra-patch-derivation.md — never editing these.

# --- firmware identity ---------------------------------------------------------
SCOURGE_FIRMWARE_ID="NE_E.EUR.S5W_L.001.001.260128"
SCOURGE_PLATFORM="Gen5W_L"            # Linux x86-64 (NOT S5W_M/Android)
SCOURGE_REGION="EU"
SCOURGE_THEME="qml_eco3.0"

# Optional mDNS uid-retention experiment, NOT car-validated; disarmed by default.
MDNSD_STOCK_SHA256="71122d8f59cdfd248f80414014e22114b0ee486415e5a7de23f5acd1676b9cdd"
MDNSD_ROOTED_SHA256="3f1cfd19210d6ac34ce24a215ed5066054ba4bbf487714f1c969114d86c6525f"

# --- official package acquisition (nudl) ----------------------------------------
NUDL_BRAND="hyundai"
NUDL_MODEL="IONIQ5_EU"
NUDL_REGION="EU"
NUDL_VERSION="NE_E.EUR.S5W_L.001.001.260128"

# --- genuine rootfs container (TE2 class 0xe0) ----------------------------------
GENUINE_BASENAME="mango-rootfs.tar.gz"
GENUINE_ENVELOPE_SIZE=879126179
GENUINE_BODY_SIZE=879109759
GENUINE_MD5="7f510002ed35972bed8edd0479c91679"
GENUINE_IV="5412d68d2f22bf3d30f3c1ff1e715326"
GENUINE_TAR_ENTRIES=66836
PATCHED_TAR_ENTRIES=66840

# --- stock /app/bin/AppUpgrade (engine host; == USB wrapper plaintext) ---------
# The rootfs-embedded copy and the decrypted 0xf5 USB wrapper are byte-identical.
APPUPGRADE_SIZE=10787256
APPUPGRADE_STOCK_SHA256="5295c6e4c41fb9c03760cf006c58b66fcd11aeb4e6e889af6e31b062549b6df0"
APPUPGRADE_STOCK_MD5="6ec7c38a27d8cb1300f0f0621e46336f"
APPUPGRADE_PATCHED_SHA256="5d8422126e5df937dbd7e69aab4652ff8188640a229a6c6f9b674a9da008dc01"
APPUPGRADE_PATCHED_MD5="c17c2655aecef461d2d9ddae15af775b"
# Embedded AppScomoUpgrade engine ELF starts at this file offset:
APPUPGRADE_ENGINE_BASE=31844

# --- stock USB AppUpgrade wrapper container (TE2 class 0xf5) -------------------
WRAPPER_SIZE=10803676
WRAPPER_STOCK_SHA256="5355059b8793f90440bbddafcb11ac884374d6b98b95309ac693a46aa70c2eca"
WRAPPER_STOCK_MD5="15a33d05b52ffa3d2ada5d44b4f37253"
WRAPPER_PATCHED_SHA256="176d4a8c9dfb409f50231f90374b302773ed181fb01a3d2ded71b13e9363a3d0"
WRAPPER_PATCHED_MD5="67a9fa486dbcae63e1a20ceee6eb2d5d"
# CAVEAT: class 0xf5 is RSA-signed over IV||ciphertext. Re-encrypting
# invalidates the OEM signature; the AppScomoDM button gate and the engine
# stubs exist to compensate. See docs/08-postroot-updates.md.

# --- stock /app/bin/AppScomoDM (UsbUpdateManager — the update-button gate) ------
APPSCOMODM_SIZE=1934752
APPSCOMODM_STOCK_SHA256="c44da21eb39987e88d71c648f625338722b8458f0ff8ecfe29e3321cf6d62046"
APPSCOMODM_STOCK_MD5="f6a87c86c5155a83d980d6fb715c81ee"
APPSCOMODM_PATCHED_SHA256="b2467b2b7cdf18b4e470b36083867411cae3b9d047739959141b333e5fa1e596"
APPSCOMODM_PATCHED_MD5="45f881b3b08f40e6e07c03988e441341"

# --- /app/bin/AppDMClient (the REAL update-button gate) ---------------------------
# AppDMClient's checkUSBUpdate() verifies the drive's AppUpgrade wrapper AND
# .lge.upgrade.xml against teruten5_pub.key and controls the Update button
# enable/disable. Two verifier entries stubbed 31 C0 C3. Baked into the
# stage-1 rootfs (build 4, ten stubs); VM-validated (A0/A1/A2), car
# validation pending — docs/08. The tools/update-debug/dmclient_gate.sh
# deployer patches an already-rooted car in place.
APPDMCLIENT_SIZE=2226072
APPDMCLIENT_STOCK_SHA256="9a1fb796d7ac24fcce71c16e3dbee9306c888f43e705ee081f41b7d473978bd0"
APPDMCLIENT_STOCK_MD5="d863bd9c15ae2defcd05553ed46eff46"
APPDMCLIENT_PATCHED_SHA256="e59259a16d3025d07a9f790a07e5eb4837df5cf69b05fcb2b3a64b281221fba5"
APPDMCLIENT_PATCHED_MD5="49c24ca88ce27b3e642a9f703b0fd1f6"

# --- /app/bin/AppLauncher (sigstub; prerequisite of the AppDMClient patch) ------
# AppLauncher RSA-verifies every startup-group/preload spawn's .sign ELF
# section against /tmp/app_normal.key; the stock launcher refuses to spawn
# a modified AppDMClient at boot, so the .sign gates must be stubbed for
# the AppDMClient patch to survive a boot. Two entries, B8 01 00 00 00 C3
# (mov eax,1; ret — true-on-success). Baked into the stage-1 rootfs
# (build 4); VM-validated, car validation pending — docs/08. The
# tools/update-debug/applauncher_sigstub.sh deployer patches an
# already-rooted car in place.
APPLAUNCHER_SIZE=407720
APPLAUNCHER_STOCK_SHA256="c8d6d56bc254ad0731e81f40bd83aa9b3be6b49bcbd8efb291157a06c4a84268"
APPLAUNCHER_STOCK_MD5="04156392f77a5c2948772dbd31690d41"
APPLAUNCHER_PATCHED_SHA256="d00efd1363dcaef2c3c5b3c5aefc01d0eea99dce84d60647ab036ce65113e2e0"
APPLAUNCHER_PATCHED_MD5="6eeb054566e3bc9a0203ecc01bde04b8"

# --- .ver manifest --------------------------------------------------------------
VER_FILE="IONIQ5_EU.ver"
VER_STOCK_SIZE=2467
VER_STOCK_SHA256="c5ebdda625c24f44eb6faa21d0b1dd59b4186acc7305807bd79b101d18cb021e"
VER_ROOTFS_ROW_ID=341174
VER_ROOTFS_ROW_STOCK_CRC="1744474344"
VER_ROOTFS_ROW_PATCHED_CRC="2114845580"
VER_WRAPPER_ROW_ID=341142
VER_WRAPPER_ROW_STOCK_CRC="609028602"
VER_WRAPPER_ROW_PATCHED_CRC="-990581836"

# --- signed manifest (never modified) ------------------------------------------
LGE_UPGRADE_XML_SHA256="7b6f9817d0ac67c36237dd0a08c1c9c73404bfc013d7c8f53b009c982e086c0e"

# --- boot message (.qm patch) ---------------------------------------------------
# Keys inside app/share/AppStandbyClock/localization/{qm,ts}/translation_en-{gb,au}
QM_KEYS="STR_PROFILE_WC_DETAIL_SAFETY_OBEY STR_WC_DETAIL_SAFETY_OBEY_IKAV"
QM_KEY_LONG_CHARS=249
QM_KEY_SHORT_CHARS=206
MESSAGE_MAX_CHARS=206
MESSAGE_SHA256="a00dd663d6f3cb791dac9b7d3d674df59f97c0f42b615a981d20c256114abb33"

# --- known-good build artifacts (build 4, ten stubs across four binaries) --------
# Your build MUST reproduce these byte-for-byte. See docs/03-stage1-build.md.
KNOWN_GOOD_ROOTFS_SHA256="9f4e495ddfb9dfc85917517ba001f9059aa4cf135c6e87cca45d3a5248de8b09"
KNOWN_GOOD_PLAINTEXT_SHA256="97486ddf29cb499585ac2012f4185c44f4c94e9658a755773a0d8b5449223f14"
KNOWN_GOOD_VER_SECOND_SHA256="2e2d305cb567364dc6364e02ce0265d22a2f6d1c022d6e39dd074f84d149371b"
KNOWN_GOOD_VER_WRAPPER_SHA256="1c7cb4b66489cdadd0d5216e95d5fa569d5ac6b8665ffe83e5a07cee1a32db97"
KNOWN_GOOD_USB_IMG_SIZE=28894603490
KNOWN_GOOD_USB_IMG_SHA256="1e0e13fd406e41c5b635230d80c22d86691ce8e78e786f6fdea4920d69be0a0f"
