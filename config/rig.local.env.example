# rig.local.env.example — copy to config/rig.local.env (gitignored) and fill in.
#
# Everything here stays on this host: the rig dashboard reads it, never serves
# it, and scripts/policy_check.py never sees the copy because it is gitignored.
# Committing this file's filled-in twin is what the `leaks` gate blocks.

# --- rig identity -------------------------------------------------------------
RIG_HOSTNAME="rig"
RIG_USER="pi"
RIG_KEY="~/.ssh/scourge_pi"

# --- WiFi (an SSID names a person's network, a PSK is a shared secret) --------
# WIFI_SSIDS: space-separated candidates, most likely first. Several spellings
# of the same network are normal (case, -5G, -ext_5G); the rig writes a
# NetworkManager profile for each and lets the radio pick.
WIFI_COUNTRY="HU"
WIFI_SSIDS="<your-ssid> <your-ssid>-5G"
WIFI_PSK="<your-psk>"

# --- WiFi fallback access point (17_provision_wifi_fallback.sh) ---------------
# When the rig cannot join any known network it raises this WPA2 AP at
# 10.42.0.1, where the setup page lets you pick a network. Minimum 8 characters.
RIG_AP_SSID="rig-setup"
RIG_AP_PASSPHRASE="<your-setup-ap-passphrase>"

# --- first-boot login ---------------------------------------------------------
RIG_PASSWORD="<your-password>"
SSH_PUBKEY="<your-public-key>"

# --- dashboard ---------------------------------------------------------------
# Token required when scripts/rig_ui.sh listens beyond loopback (--host 0.0.0.0):
# the page can run build scripts and sudo on the rig. Generate one with
#   openssl rand -hex 16
# Leave empty for the default 127.0.0.1 bind, which needs no gate.
RIGDASH_TOKEN=""

# --- optional ----------------------------------------------------------------
# Only needed when the dashboard should run sudo commands on the rig itself
# (10_provision_pi.sh). Leave empty and the UI prints the command to copy
# instead of running it.
SUDO_PASSWORD=""
# Card image and boot-partition label used by the flash/SD steps.
PI_IMAGE="$HOME/piimg/2026-10-06-raspios-trixie-arm64-lite.img.xz"
PI_BOOTFS_LABEL="bootfs"
# exFAT stick that carries usb.img when it does not fit the SD card (Pi 4/5).
# 10_provision_pi.sh mounts LABEL=<this> at /media/<this>, ro,nofail.
RIG_IMAGE_STICK_LABEL="RIGIMG"
