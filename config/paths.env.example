# SCOURGE build paths — copy to config/paths.local.env (gitignored) and edit.
# Every value can also be exported as an environment variable of the same name.
# Nothing here is secret; the TE2 key lives in config/key.local (see
# config/key.local.example).

# Python interpreter used by the build tools.
# Default: the repo venv created by scripts/00_env.sh (.venv/bin/python).
PYTHON=".venv/bin/python"

# Where the official firmware inputs are staged by scripts/01_stage_inputs.sh
# (nudl download or user-provided tree/zip). Must contain:
#   mango-rootfs.tar.gz  AppUpgrade.usb  IONIQ5_EU.ver  .lge.upgrade.xml
# and (for the vanilla USB image / packages) the full stock package tree.
INPUT_DIR="input"
STOCK_PACKAGE="input/package_stock"

# Where the fetched third-party dependencies live
# (scripts/00_fetch_third_party.sh clones them here, gitignored).
THIRD_PARTY_DIR="third_party"
TOCTOU_REPO="third_party/ioniq5-usb-toctou"
HKG_TOOLS_REPO="third_party/hkmcavn-tools"
NUDL_BIN="third_party/nudl/nudl"

# Build outputs.
WORK_DIR="work"
OUT_DIR="out"

# Pi rig (for the TOCTOU deployment). Set these for your own Pi.
PI_HOST="192.168.0.10"
PI_USER="pi"
PI_DIR="scourge"

# Pi SD card identification for scripts/13_copy_image_to_sd.sh
# (find your card's LABEL/PARTUUID with: lsblk -o NAME,LABEL,PARTUUID)
PI_ROOTFS_LABEL="rootfs"
PI_ROOTFS_PARTUUID=""

# Container runtime used only by packages/wifi/scripts/build_dropbear.sh
# (docker or podman; empty = fall back to host musl-gcc).
CONTAINER_RUNTIME=""
