# --- secrets & local configuration -------------------------------------------
config/key.local
config/paths.local.env
# any per-target/local override env file
*.local.env
*.key
*.local

# --- fetched third-party dependencies (pinned, never committed) --------------
third_party/

# --- owner stock QML bases (read by build_artifacts.py at build time; -------
# --- OEM-derived, never committed) -------------------------------------------
packages/*/base/
packages/*/build/
packages/wifi/backup/
packages/wifi/artifacts/assets/wifi/
packages/wifi/artifacts/bin/
packages/wifi/artifacts/qml/**/QHMI_HomeScreenMain_*.qml
packages/wifi/artifacts/qml/**/Screen_HomeScreen_*.qml
packages/wifi/artifacts/qml/**/QCustomizedMenuListAllowEmpty.*.qml
packages/wifi/artifacts/qml/**/common/
packages/tweaks/artifacts/qml/**/QHMI_HomeScreenMain_*.qml
packages/tweaks/artifacts/qml/**/Screen_HomeScreen_*.qml
packages/tweaks/artifacts/qml/**/QCustomizedMenuListAllowEmpty.*.qml
packages/tweaks/artifacts/qml/**/common/
packages/tweaks/artifacts/qml/AppStandbyClock/
packages/wifi/bin/

# --- VM-lab run/build outputs (serial logs, screenshots, result.json; --------
# --- runtime/build artifacts and car captures, never committed) --------------
tools/vm/runs/
tools/vm/.cache/
tools/vm/build/
tools/vm/guest/micom-dbus-sim
tools/vm/guest/usb-mount-signal
tools/vm/toolsroot/applauncher-stub
tools/vm/toolsroot/appmanager-stub
tools/vm/toolsroot/automount-stub
tools/vm/toolsroot/credman-stub
tools/vm/toolsroot/entropy-seed
tools/vm/payload/tweaks-vm/tweaks-micom-can-sim
tools/vm/payload/tweaks-vm/mock-dm-shm
tools/vm/payload/tweaks-vm/mock-oem-queue
tools/vm/payload/tweaks-vm/mock-dm-server
/captures/
/car-assets/
/car-local/
# Backing images are prepared from the owner's own staged firmware (docs/14).
# Symlinks/copies are convenient locally but must never be committed.
tools/vm/*.img
tools/vm/bzImage
tools/vm/vmlinux.patched
tools/vm/compat/kernel
tools/vm/compat/initramfs-linux.img

# --- firmware inputs & build outputs ------------------------------------------
# The official firmware package, decrypted plaintexts, and all built artifacts
# are OEM-derived. They are generated locally and never committed.
input/
work/
out/
binroot/
usb.img
*.te2
*.tar.gz
!docs/**/*.tar.gz

# --- python --------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.pyc

# --- rust ----------------------------------------------------------------------
target/

# --- editors / OS --------------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store

# --- compiled package daemons (built locally, never committed) ---------------
packages/java/out/
packages/battery/src/battery_daemon
packages/wifi/src/wifi_daemon
packages/wifi1b/src/wifi1b_daemon
packages/wifi1b/src/wifi1b_qmlpatch
packages/wifi1b/artifacts/assets/wifi1b/
packages/tweaks/src/tweaks_daemon
packages/projection/src/projection_daemon
packages/tweaks/src/tweaks_persist
packages/tweaks/src/wrandr_wrapper

# --- HUD Nav backend (WIP) ----------------------------------------------------
# Host-only build/runtime outputs. Generated from the owner's own firmware;
# never commit a shim, daemon binary, generated header, kit or car capture.
packages/hudnav/build/
packages/hudnav/out/
packages/hudnav/src/hudnavd
packages/hudnav/src/*.so
packages/hudnav/tests/fixtures/
packages/hudnav/captures/
packages/projection/design/shots/
