# --- secrets & local configuration -------------------------------------------
config/key.local
config/paths.local.env
*.key
*.local

# --- fetched third-party dependencies (pinned, never committed) --------------
third_party/

# --- owner stock QML bases (read by build_artifacts.py at build time; -------
# --- OEM-derived, never committed) -------------------------------------------
packages/*/base/
packages/*/build/
packages/wifi/backup/
packages/wifi/artifacts/assets/wifi/
packages/wifi/artifacts/bin/
packages/wifi/artifacts/qml/**/QHMI_HomeScreenMain_*.qml
packages/wifi/artifacts/qml/**/Screen_HomeScreen_*.qml
packages/wifi/artifacts/qml/**/QCustomizedMenuListAllowEmpty.*.qml
packages/wifi/artifacts/qml/**/common/
packages/tweaks/artifacts/qml/**/QHMI_HomeScreenMain_*.qml
packages/tweaks/artifacts/qml/**/Screen_HomeScreen_*.qml
packages/tweaks/artifacts/qml/**/QCustomizedMenuListAllowEmpty.*.qml
packages/tweaks/artifacts/qml/**/common/
packages/wifi/bin/

# --- VM-lab run outputs (serial logs, screenshots, result.json; -------------
# --- runtime artifacts, never committed) --------------------------------------
tools/vm/runs/

# --- firmware inputs & build outputs ------------------------------------------
# The official firmware package, decrypted plaintexts, and all built artifacts
# are OEM-derived. They are generated locally and never committed.
input/
work/
out/
binroot/
usb.img
*.te2
*.tar.gz
!docs/**/*.tar.gz

# --- python --------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.pyc

# --- editors / OS --------------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store

# --- compiled package daemons (built locally, never committed) ---------------
packages/battery/src/battery_daemon
packages/wifi/src/wifi_daemon
packages/tweaks/src/tweaks_daemon
packages/tweaks/src/tweaks_persist
packages/tweaks/src/wrandr_wrapper
